# ================================
# Ziva HOUSING — Environment Vars
# ================================
# Copy this to .env and fill in your values

# --- Database ---
DATABASE_URL="postgresql://Ziva_user:Ziva_pass_2024@localhost:5432/Ziva_housing"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- JWT ---
JWT_SECRET="change-me-to-a-long-random-secret-at-least-64-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret-also-very-long"
JWT_REFRESH_EXPIRES_IN="7d"

# --- OTP (MSG91) ---
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID="ZivaH"

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="noreply@Zivahousing.com"

# --- Storage (MinIO local / S3 in prod) ---
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="Ziva_minio_admin"
S3_SECRET_KEY="Ziva_minio_secret_2024"
S3_BUCKET_PROPERTIES="Ziva-properties"
S3_BUCKET_DOCUMENTS="Ziva-documents"
S3_REGION="ap-south-1"

# --- Razorpay ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- App ---
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
NODE_ENV="development"

# --- Commission ---
DEFAULT_COMMISSION_RATE=2.5   # percentage
GST_RATE=18                   # percentage
